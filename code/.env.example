# Copy thanh file .env roi dien username va Active Key.
# Active Key lay o io.adafruit.com (bieu tuong chia khoa vang), khong phai mat khau dang nhap.

AIO_USERNAME=ten-tai-khoan
AIO_KEY=aio_xxxx

COM_PORT=COM11
BAUD=115200
READ_INTERVAL=3

FEED_TEMP=nhiet-do
FEED_HUMID=do-am
FEED_LIGHT=anh-sang
FEED_ALERT=canh-bao
FEED_TEMP_MAX=nguong-nhiet
FEED_HUMID_MAX=nguong-am
FEED_LIGHT_MIN=nguong-sang

# Canh bao khi nhiet do > TEMP_MAX, do am > HUMID_MAX, anh sang < LIGHT_MIN
TEMP_MAX=32
HUMID_MAX=80
LIGHT_MIN=20

# Web (Module 5). Mo http://127.0.0.1:8000 tren trinh duyet cua laptop.
# WEB_PASSWORD bat buoc khi chay web_server.py. Dat mat khau rieng, khong dung lai AIO_KEY.
WEB_PORT=8000
WEB_PASSWORD=
# mock = gia lap; gateway = web chay luon Module 1 + 2 (can board, khong chay them gateway.py); live = chi doc Adafruit
WEB_DATA=mock
MOCK_ACK_MS=900
