# Copy thanh file .env roi dien username va Active Key.
# Active Key lay o io.adafruit.com (bieu tuong chia khoa vang), khong phai mat khau dang nhap.

AIO_USERNAME=ten-tai-khoan
AIO_KEY=aio_xxxx

COM_PORT=COM11
BAUD=115200
READ_INTERVAL=3

FEED_TEMP=nhiet-do
FEED_HUMID=do-am
FEED_LIGHT=anh-sang
FEED_ALERT=canh-bao
FEED_TEMP_MAX=nguong-nhiet
FEED_HUMID_MAX=nguong-am
FEED_LIGHT_MIN=nguong-sang

# Canh bao khi nhiet do > TEMP_MAX, do am > HUMID_MAX, anh sang < LIGHT_MIN
TEMP_MAX=32
HUMID_MAX=80
LIGHT_MIN=20

# Web (Module 5). Mo http://127.0.0.1:8000 tren trinh duyet cua laptop.
# WEB_PASSWORD bat buoc khi chay web_server.py. Dat mat khau rieng, khong dung lai AIO_KEY.
WEB_PORT=8000
WEB_PASSWORD=
# mock = gia lap; gateway = web chay luon Module 1 + 2 (can board, khong chay them gateway.py); live = chi doc Adafruit
WEB_DATA=mock
MOCK_ACK_MS=900

# Servo cua. Mac dinh P4 (tai lieu servo OhStem). Khong dung P0 (anh sang) hay P14 (RGB).
# Doi SERVO_PIN khi nhom chot cong. Goc mo/dong sua trong yolobit.py (DOOR_OPEN_ANGLE, DOOR_CLOSED_ANGLE).
SERVO_PIN=P4
DOOR_OPEN_SECONDS=10

# Nhan dien khuon mat tren webcam laptop. De 0 khi chua chup anh va chua train.
# Sau khi chay face_train.py, dat FACE_ENABLE=1 roi chay web_server.py voi WEB_DATA=gateway.
FACE_ENABLE=0
FACE_CAMERA=0
# De trong de dung nguong trong models/face/chosen.json. Dien so neu muon thu nguong khac luc demo.
# FACE_THRESHOLD=
FACE_STABLE_FRAMES=3
FACE_MISS_RESET=1
FACE_INTERVAL=0.3
