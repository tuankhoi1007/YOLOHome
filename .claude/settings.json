{
  "permissions": {
    "allow": [
      "Bash(python3 -m py_compile:*)",
      "Bash(python3 -m unittest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch --list:*)",
      "mcp__figma__whoami",
      "mcp__figma__create_session",
      "mcp__figma__get_metadata",
      "mcp__figma__get_screenshot",
      "mcp__figma__get_design_context",
      "mcp__figma__get_variable_defs"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git reset:*)",
      "Bash(git stash:*)",
      "Bash(pip install:*)",
      "Bash(npm install:*)",
      "Edit(/docs/PROTOCOL.md)",
      "Write(/docs/PROTOCOL.md)",
      "mcp__figma__use_figma",
      "mcp__figma__generate_figma_design",
      "mcp__figma__upload_assets"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(rm -rf:*)",
      "Read(**/.env)",
      "Edit(**/.env)",
      "Write(**/.env)",
      "Bash(cat *.env)",
      "Edit(/User_Requirements.md)",
      "Write(/User_Requirements.md)",
      "Edit(/code/board_main_backup.py)",
      "Write(/code/board_main_backup.py)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_py.py\""
          }
        ]
      }
    ]
  }
}
